# Set the verified public origin when preparing a release.
# NEXT_PUBLIC_SITE_URL=https://your-confirmed-domain.de

# --- Contact form (server only; never commit real values) ---
# Resend (https://resend.com) API key, a recipient and a verified sender address.
# Until all three are set, /api/contact answers 503 and the form shows an error.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# --- Public contact details (shown only when set) ---
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_INSTAGRAM_URL=
